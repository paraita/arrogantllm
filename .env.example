# Keep local authentication unless Traefik/Authelia protects ALL dashboard routes.
# With false: require PUBLIC_BASE_URL; remove ADMIN_PASSWORD and ADMIN_SESSION_SECRET
# below to use an automatically generated CSRF session secret (changes on restart).
ADMIN_AUTH_ENABLED=true

# Local dashboard login. Change this before exposing the dashboard beyond localhost.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional runtime configuration
PORT=8080
DATA_DIR=./data
API_DELAY_MIN_MS=180
API_DELAY_MAX_MS=900
# Public origin for examples and admin CSRF checks.
# Default Compose uses http://localhost:8080 when blank; set HTTPS behind a proxy.
# Example: PUBLIC_BASE_URL=https://llm.example.com
PUBLIC_BASE_URL=

# Per-process safeguards; configure per-client limits at Traefik as well.
LOGIN_RATE_LIMIT=10
MAX_CONCURRENT_REQUESTS=64
MAX_ADMIN_CONCURRENT_REQUESTS=16
